{
  "name": "pr-stacks-extension",
  "version": "0.3.1",
  "private": true,
  "description": "Reviewer-side PR layering for GitHub (Chrome MV3). Read-only, no backend, no AI.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm test && npm run build && python3 scripts/zip.py",
    "analyze-pr": "npx tsx scripts/analyze-pr.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^15.11.7",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
