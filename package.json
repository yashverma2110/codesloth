{
  "name": "codesloth",
  "version": "0.7.0",
  "private": true,
  "description": "Reviewer-side PR layering for GitHub (Chrome MV3). Read-only, no backend, no AI.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm test && npm run build && python3 scripts/zip.py",
    "analyze-pr": "npx tsx scripts/analyze-pr.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
